# Google Gemini API key for AI-generated packing tips (gemini-2.0-flash-lite).
# Get one (free) at https://aistudio.google.com/app/apikey
#
# NOTE: this project currently has no build step (in-browser Babel). The
# actual key is read from window.__GEMINI_API_KEY__ in index.html, NOT
# from this .env file. This file exists as collaborator documentation
# and as a placeholder for a future Vite migration.
VITE_GEMINI_API_KEY=your_key_here
